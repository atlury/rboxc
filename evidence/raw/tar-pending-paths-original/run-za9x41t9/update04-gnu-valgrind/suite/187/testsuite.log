echo Create
tar cf archive ./file.*
sleep 1
echo "update" > file.b
echo First update
tar ufv archive --wildcards './file.*'

echo "Second update"
tar ufv archive --wildcards './file.*'

echo "Non-matching pattern"
tar ufv archive --wildcards './file.*' './foo.*'
echo $?
)
